{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\kernals\\OneDrive\\Documents\\microdistro-main\\afterburner\\out\\extension.js",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        },
        {
            "name": "Run import platform",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}\\.vscode\\import platform.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Open afterburner.inf",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}\\.vscode\\afterburner.inf",
            "args": []
        }
    ]
}